---
/**
 * Video that integrates with the presentation controller.
 *
 * In normal mode it behaves like the existing <Video> component.
 * In presentation mode the controller will:
 *   1. unmute (if `unmuteOnPresent`)
 *   2. play() the video from the start
 *   3. await the `ended` event (if `awaitEnd`) before moving on
 *
 * The wrapping <PresentationSection> should usually have its own
 * holdAfter set to something small (e.g. 600ms), since the video
 * itself provides the dwell time.
 */

import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"video"> {
  src: string;
  /** Wait for the video to finish before advancing. Default true. */
  awaitEnd?: boolean;
  /** Restart from 0 when entering. Default true. */
  restart?: boolean;
  /** Unmute when presentation starts (browsers may still block). Default false. */
  unmuteOnPresent?: boolean;
}

const {
  src,
  controls = true,
  loop = false,
  playsinline = true,
  muted = true,
  autoplay = false,
  awaitEnd = true,
  restart = true,
  unmuteOnPresent = false,
  ...videoProps
} = Astro.props;
---

<video
  data-present-video
  data-present-await-end={awaitEnd ? "true" : "false"}
  data-present-restart={restart ? "true" : "false"}
  data-present-unmute={unmuteOnPresent ? "true" : "false"}
  class="aspect-video h-auto w-full rounded-lg"
  src={src}
  controls={controls}
  loop={loop}
  playsinline={playsinline}
  muted={muted}
  autoplay={autoplay}
  {...videoProps}></video>
